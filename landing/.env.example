PORT=3000
PUBLIC_BASE_URL=https://fractalmusicworld.com
FMW_ADMIN_TOKEN=cambie-este-token-por-uno-largo-y-privado

MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

COMPRACLICK_CHECKOUT_URL=
COMPRACLICK_WEBHOOK_SECRET=

# Ruta absoluta al archivo digital definitivo que se entregará tras el pago
FMW_PRODUCT_FILE=
FMW_DELIVERY_TOKEN_HOURS=72

# Correo transaccional (Resend)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Fractal Music World <noreply@fractalmusicworld.com>
EMAIL_REPLY_TO=

# Seguridad y recuperación
FMW_RECOVERY_MAX_PER_HOUR=5
FMW_TRUST_PROXY=false
NODE_ENV=production

# Ruta del host usada por compose.yaml
FMW_PRODUCT_HOST_PATH=/ruta/absoluta/El_Lujo_de_la_Disonancia.pdf
